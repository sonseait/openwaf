# Một biến cho mỗi credential dùng chung; DB URLs được ghép trong Compose.
# Copy sang .env khi chưa có file, rồi điền credentials đang dùng.

# PostgreSQL pgaio — credentials dùng chung
HOMELAB_PGAIO_USER='postgres'
HOMELAB_PGAIO_PASSWORD='CHANGE_ME'
HOMELAB_PGAIO_AWS_ACCESS_KEY_ID='CHANGE_ME'
HOMELAB_PGAIO_AWS_SECRET_ACCESS_KEY='CHANGE_ME'
HOMELAB_PGAIO_WALG_LIBSODIUM_KEY='CHANGE_ME'

# Immich PostgreSQL riêng
HOMELAB_IMMICH_DB_PASSWORD='CHANGE_ME'

# Redis — server và tất cả client
HOMELAB_REDIS_PASSWORD='CHANGE_ME'

# Meilisearch — server và Alist
HOMELAB_MEILISEARCH_KEY='CHANGE_ME'

# Traefik
HOMELAB_TRAEFIK_CF_DNS_API_TOKEN='CHANGE_ME'

# Aria2
HOMELAB_ARIA2_RPC_SECRET='CHANGE_ME'

# Vaultwarden
HOMELAB_VAULTWARDEN_PUSH_INSTALLATION_ID='CHANGE_ME'
HOMELAB_VAULTWARDEN_PUSH_INSTALLATION_KEY='CHANGE_ME'

# MinIO
HOMELAB_MINIO_ROOT_USER='CHANGE_ME'
HOMELAB_MINIO_ROOT_PASSWORD='CHANGE_ME'

# Hasura
HOMELAB_HASURA_ADMIN_SECRET='CHANGE_ME'

# OnlyOffice — MySQL, JWT và machine key
HOMELAB_ONLYOFFICE_MYSQL_PASSWORD='CHANGE_ME'
HOMELAB_ONLYOFFICE_JWT_SECRET='CHANGE_ME'
HOMELAB_ONLYOFFICE_MACHINE_KEY='CHANGE_ME'

# Kutt
HOMELAB_KUTT_JWT_SECRET='CHANGE_ME'

# Pumpbot
HOMELAB_PUMPBOT_TELEGRAM_TOKEN='CHANGE_ME'

# JFE — API backend và các worker dùng chung
HOMELAB_JFE_OPENSUBTITLES_API_KEY='CHANGE_ME'
HOMELAB_JFE_OPENSUBTITLES_PASSWORD='CHANGE_ME'
HOMELAB_JFE_GEMINI_API_KEY='CHANGE_ME'
HOMELAB_JFE_TMDB_TOKEN='CHANGE_ME'
