# Local development (dotenv syntax); quote values containing spaces, $, #, etc.
# Gateway/Admin CLI/collector load .env in the working directory, including Cargo runs.
# Existing environment overrides this file. Run from backend/ for relative paths.
# OPENWAF_ENV_FILE=/dev/null disables loading (Make: ENV_FILE=/dev/null).
# Optional settings must stay commented when unused (not empty strings).

# Gateway: standalone until OPENWAF_DATABASE_URL is configured below.
OPENWAF_LISTEN=127.0.0.1:8080
OPENWAF_UPSTREAM=127.0.0.1:8081
OPENWAF_RULES=./runtime/modsecurity.conf
# Native local CRS, when provisioned in backend/.dev:
# OPENWAF_RULES=./.dev/modsecurity.conf
OPENWAF_WAF_MODE=DetectionOnly

# Managed gateway + Admin API, required for the dashboard.
# Deployment templates enable this guard against accidental standalone startup:
# OPENWAF_REQUIRE_MANAGED=true
# PostgreSQL must already exist. Supply your own credentials if required.
# OPENWAF_DATABASE_URL='postgres://postgres@127.0.0.1:5432/openwaf'
# OPENWAF_ADMIN_MASTER_KEY_FILE='/absolute/path/outside-repo/admin-master.key'
OPENWAF_ADMIN_LISTEN=127.0.0.1:9090
OPENWAF_ADMIN_ORIGIN=https://localhost:5173
# Public admin bootstrap profile supplies these before opening the listener.
# See deploy/vps/README.md; do not enable on an existing config without migration.
# OPENWAF_ADMIN_PUBLIC=true
# OPENWAF_ADMIN_HOST=admin.example.com
# OPENWAF_ADMIN_INITIAL_PASSWORD_FILE='/absolute/private/initial-admin-password'
# OPENWAF_ADMIN_INITIAL_USERNAME=admin
# Public origin must then be exactly https://admin.example.com (port 443).
# Wildcard listeners need local IP inventory: configure it here or enable discovery below.
# OPENWAF_LOCAL_IPS=127.0.0.1,192.0.2.10
# Merge current interface IPv4/IPv6 addresses at startup (VPS Compose enables this).
# OPENWAF_DISCOVER_LOCAL_IPS=true

# sqlx-cli reads DATABASE_URL, whereas OpenWAF reads OPENWAF_DATABASE_URL.
# Set the same database URL here if using `sqlx migrate run` from backend/.
# DATABASE_URL='postgres://postgres@127.0.0.1:5432/openwaf'

# Optional gateway TLS / upstream trust (verification remains enabled).
# OPENWAF_TLS_MANIFEST='/absolute/path/tls/manifest.json'
# OPENWAF_UPSTREAM_CA_FILE='/absolute/path/upstream-ca.pem'

# Optional telemetry dependencies; remote service origins require HTTPS.
# OPENWAF_CLICKHOUSE_URL=http://127.0.0.1:8123/
# OPENWAF_CLICKHOUSE_CREDENTIAL_FILE='/absolute/path/outside-repo/clickhouse.json'
# OPENWAF_PROMETHEUS_URL=http://127.0.0.1:9091/
# OPENWAF_METRICS_TOKEN_FILE='/absolute/path/outside-repo/metrics-token'

# Optional security services.
# OPENWAF_CROWDSEC_CONFIG='/absolute/path/outside-repo/crowdsec.json'
# OPENWAF_GEOIP_DB='/absolute/path/GeoLite2-Country.mmdb'

# Optional discovery. Collector is a separate process in the host namespace.
# Socket directory must be owned by collector UID with mode 0700.
# Gateway also requires OPENWAF_DISCOVERY_UID when socket is configured.
# OPENWAF_DISCOVERY_SOCKET='/absolute/path/discovery/collector.sock'
# OPENWAF_DISCOVERY_UID=1000
# OPENWAF_DOCKER_SOCKET=/var/run/docker.sock
# OPENWAF_DISCOVERY_EXCLUDE=127.0.0.1:8080,127.0.0.1:9090
# OPENWAF_GATEWAY_NETWORK_MODE=bridge
# OPENWAF_GATEWAY_DOCKER_NETWORKS=openwaf
# OPENWAF_GATEWAY_CONTAINER_IDS=openwaf-gateway

# Optional built React dashboard directory (bundled in the production image).
# OPENWAF_ADMIN_UI_ROOT=/absolute/path/to/frontend/dist
