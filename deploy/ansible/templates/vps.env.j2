# Managed by Ansible. Private values live in root-only files and host bind mounts.
OPENWAF_DATA_DIR={{ openwaf_data_dir }}
OPENWAF_IMAGE={{ openwaf_image }}
OPENWAF_INIT_IMAGE={{ openwaf_init_image }}
OPENWAF_VPS_PROFILE={{ openwaf_detected.profile }}
OPENWAF_ADMIN_HOST={{ openwaf_admin_host }}
OPENWAF_ORIGIN_IPV4={{ openwaf_detected.ipv4 }}
OPENWAF_ORIGIN_IPV6={{ openwaf_detected.ipv6 }}
OPENWAF_CLOUDFLARE_API_TOKEN_FILE={{ openwaf_secrets_dir }}/cloudflare-token
OPENWAF_ACME_ACCEPT_TERMS={{ openwaf_acme_accept_terms | ternary('true', 'false') }}
OPENWAF_ACME_DNS_RESOLVER={{ openwaf_acme_dns_resolver }}
OPENWAF_POSTGRES_CREATE={{ openwaf_detected.postgres_create | ternary('1', '0') }}
OPENWAF_DATABASE_URL_FILE={{ (openwaf_secrets_dir ~ '/database-url') if not openwaf_detected.postgres_create else '' }}
OPENWAF_DATABASE_CA_FILE={{ (openwaf_secrets_dir ~ '/database-ca.pem') if openwaf_database_ca_file else '' }}
OPENWAF_DOCKER_NETWORK_NAME={{ openwaf_docker_network_name }}
OPENWAF_DOCKER_NETWORK_EXTERNAL={{ openwaf_docker_network_external | ternary('true', 'false') }}
OPENWAF_DOCKER_SOCKET={{ openwaf_docker_socket }}
OPENWAF_DOCKER_GID={{ openwaf_socket.stat.gid }}
OPENWAF_GEOIP_DIR=./geoip
{% if openwaf_geoip_file %}
OPENWAF_GEOIP_DB=/etc/openwaf-geoip/GeoLite2-Country.mmdb
{% endif %}
