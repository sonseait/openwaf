{
  "name": "openwaf-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "OPENWAF_UI_TLS_CERT=./.dev/cert.pem OPENWAF_UI_TLS_KEY=./.dev/key.pem vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.0",
    "@tanstack/react-query": "^5.90.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.18",
    "lucide-react": "^0.468.0",
    "mantine-datatable": "^8.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  }
}
